{
  // Gas-phase reactions for well-mixed volumes. Rates in mol/(m³·s) with concentrations in mol/m³:
  //   r_f = A · T^b · exp(−Ea / R T) · Π c_i^order_i
  // "orders" default to the reactant stoichiometric coefficients (an elementary step). A "reversible" reaction
  // runs backwards at r_r = r_f(products…) / K_c with K_c from the substances' Gibbs energies, so it always
  // relaxes to thermodynamic equilibrium (detailed balance); a global, irreversible one is marked so.
  // Sources:
  //  [BORRELL] Borrell, Cobos & Luther, J. Phys. Chem. 92, 4377 (1988): N2O4 dissociation, high-pressure limit
  //            k ≈ 10^16 exp(−6460 K / T) s⁻¹ (here 1e14 with the same activation energy: the bath-gas
  //            fall-off at 1 bar slows it by ~10–100×; equilibrium is still reached in well under a millisecond)
  //  [WD]      Westbrook & Dryer, Combust. Sci. Technol. 27, 31 (1981); the single-step methane–air form used in
  //            ANSYS Fluent ("methane-air-1step"): A = 2.119e11 (kmol/m³)^−0.5/s, Ea = 2.027e8 J/kmol,
  //            [CH4]^0.2 [O2]^1.3 — converted to mol/m³: A = 2.119e11 / 1000^0.5 = 6.70e9.
  //            A global fit to laminar flame speeds: it reproduces heat release and ignition near 1000 K, not
  //            intermediate species (no CO, no dissociation) — adiabatic flame temperatures come out
  //            ~100–200 K high.
  "reactions": [
    {"id": "n2o4_dissociation", "equation": "N2O4 <=> 2 NO2",
     "reactants": {"N2O4": 1}, "products": {"NO2": 2}, "reversible": true,
     "A": 1e14, "b": 0, "Ea": 53700, "source": "BORRELL"},
    {"id": "methane_combustion", "equation": "CH4 + 2 O2 -> CO2 + 2 H2O",
     "reactants": {"CH4": 1, "O2": 2}, "products": {"CO2": 1, "H2O": 2}, "reversible": false,
     "orders": {"CH4": 0.2, "O2": 1.3},
     "A": 6.70e9, "b": 0, "Ea": 202700, "source": "WD"}
  ]
}
